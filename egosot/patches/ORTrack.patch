+    for k in range(3):
+        if pack[k, 0] <= 1e-4: break
+        q = pack[k, 4:8]
+        cands.append(dict(box=[q[0] + cx - h0 - q[2] / 2, q[1] + cy - h0 - q[3] / 2, q[2], q[3]], s=float(pack[k, 1]),
+                          sharp=float(pack[k, 2]), sim=float(pack[k, 3]), f=fs[k]))
