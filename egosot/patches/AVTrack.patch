+            q = p1[ok][inl.ravel() == 1].reshape(-1, 2)
+            keep = ~((q[:, 0] > x - w) & (q[:, 0] < x + 2 * w) & (q[:, 1] > y - h) & (q[:, 1] < y + 2 * h))
+            self.pts = q[keep].reshape(-1, 1, 2).astype(np.float32)
