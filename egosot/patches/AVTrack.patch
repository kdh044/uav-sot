+                                         minDistance=8, mask=mask)
+        if p0 is None or len(p0) < 12:
+            self.pts = None
+            return None
+        win = (15, 15) if fast else (21, 21)
+        p1, st, _ = cv2.calcOpticalFlowPyrLK(self.prev_gray, gray, p0, None, winSize=win, maxLevel=3)
