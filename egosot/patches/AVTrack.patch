+        H_img, W_img = image.shape[:2]
+        if not np.all(np.isfinite(box)) or box[2] > W_img or box[3] > H_img:  # 박스 폭주 방지
+            box = [box[0], box[1], min(max(box[2], 1), W_img), min(max(box[3], 1), H_img)]
+        c = np.array([box[0] + box[2] / 2, box[1] + box[3] / 2])
+        self.H = None
+        if self.use_cmc:
