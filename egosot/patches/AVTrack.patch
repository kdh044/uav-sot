+
+    def init(self, image, box):
+        self.prev_gray = self._gray(image)
+        self.prev_center = np.array([box[0] + box[2] / 2, box[1] + box[3] / 2])
+        self.vel[:] = 0
+        self.cum_angle = 0.0
+
+    def _homography(self, gray, box):
